{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Goal",
  "version": "0.1.4",
  "identifier": "dev.lordcasser.planner",
  "build": {
    "beforeDevCommand": "npm run desktop:before-dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run desktop:before-build",
    "beforeBundleCommand": "npm run desktop:before-bundle",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Goal",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "decorations": true,
        "theme": "Light",
        "dragDropEnabled": false,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ],
    "category": "Productivity"
  }
}
