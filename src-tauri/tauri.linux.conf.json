{
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Planner",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "decorations": true,
        "theme": "Light",
        "dragDropEnabled": false,
        "visible": true
      }
    ]
  },
  "bundle": {
    "targets": ["appimage", "deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ],
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0"]
      }
    }
  }
}
